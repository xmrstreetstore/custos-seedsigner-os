#!/usr/bin/env python3
"""
Probe the smartcard stack and print a report.

Written against what is actually in the image: there is no pcsc_scan and no
opensc-tool here (they live in pcsc-tools / opensc, which we do not install), so
this goes through pyscard - the same library the app uses. If this says the
reader is there, the app will see it too.

Prints to stdout. The init script captures that to the boot partition so it can
be read on any computer, which is the only way to get diagnostics off a Pi Zero
1.3 with no video, no radio and no usable USB networking on a Windows host.
"""
import os
import subprocess
import sys
import time

WIDTH = 72


def head(title):
    print("\n" + "=" * WIDTH)
    print(title)
    print("=" * WIDTH)


def run(cmd, limit=40):
    try:
        out = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=20)
        lines = (out.stdout + out.stderr).strip().splitlines()
        return "\n".join(lines[:limit]) or "(no output)"
    except Exception as exc:                      # noqa: BLE001 - diagnostics
        return f"(failed: {exc})"


def main() -> int:
    print("Custos OS smartcard self-test")
    print(f"generated: {time.strftime('%Y-%m-%d %H:%M:%S')} (device clock, likely wrong)")
    print(f"python:    {sys.version.split()[0]}")

    head("1. the UART the SEC1210 lives on")
    # The reader is a *serial* CCID device on /dev/ttyAMA0. If Bluetooth were
    # holding that UART this is where it would show.
    print(f"/dev/ttyAMA0 exists: {os.path.exists('/dev/ttyAMA0')}")
    print(run("ls -l /dev/ttyAMA* /dev/serial* 2>&1"))
    print("\n-- kernel messages --")
    print(run("dmesg | grep -iE 'ttyAMA|uart|dwc2|bluetooth|bcm2835-aux' | tail -20"))

    head("2. pcscd")
    pids = run("pidof pcscd")
    print(f"pcscd running: {pids}")
    if "failed" in pids or not pids.strip() or pids == "(no output)":
        print("\npcscd not running - starting it in the foreground to capture why:")
        print(run("pcscd -f -d 2>&1 & sleep 4; kill %1 2>/dev/null", limit=60))
    print("\nreader config:")
    print(run("cat /etc/reader.conf.d/* 2>&1"))

    head("3. readers, via pyscard (what the app will use)")
    try:
        from smartcard.System import readers
        rs = readers()
        print(f"pyscard sees {len(rs)} reader(s)")
        for r in rs:
            print(f"  - {r}")
        if not rs:
            print("\nNo readers. Most likely causes, in order:")
            print("  * the SEC1210 hat is not seated / not powered")
            print("  * pcscd is not running (see section 2)")
            print("  * something else is holding /dev/ttyAMA0 (see section 1)")
        for r in rs:
            try:
                conn = r.createConnection()
                conn.connect()
                atr = " ".join(f"{b:02X}" for b in conn.getATR())
                print(f"\n  card in {r}:\n    ATR: {atr}")
                conn.disconnect()
            except Exception as exc:              # noqa: BLE001
                print(f"\n  no card in {r} ({type(exc).__name__}: {exc})")
    except Exception as exc:                      # noqa: BLE001
        print(f"pyscard failed to load or query: {type(exc).__name__}: {exc}")

    head("4. the libraries the SeedKeeper features need")
    for mod in ("smartcard", "pysatochip", "pygp"):
        try:
            m = __import__(mod)
            print(f"  {mod:12s} ok   {getattr(m, '__version__', '(no __version__)')}")
        except Exception as exc:                  # noqa: BLE001
            print(f"  {mod:12s} FAILED  {type(exc).__name__}: {exc}")

    head("5. bundled applets")
    print(run("ls -l /opt/javacard-cap/ 2>&1"))

    head("6. usb / misc")
    print(run("lsusb 2>&1"))
    print("\n-- radios (a release image must show nothing here) --")
    print(run("ls /sys/class/net/ 2>&1"))
    print(run("ls /lib/firmware/brcm 2>&1 | head -5"))

    print("\n" + "=" * WIDTH)
    print("end of report")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
