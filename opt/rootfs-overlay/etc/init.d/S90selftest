#!/bin/sh
# Provides: smartcard self-test to the boot partition
#
# Opt-in. Does nothing unless a file whose name starts with `smartcard-selftest`
# exists on the boot (FAT) partition, so a normal boot writes nothing at all -
# this is a signing device and unrequested writes to the card are a liability.
#
# Why this exists: a Pi Zero 1.3 has no video output, no radio, and its USB
# ethernet gadget does not bind on Windows (the host attaches usbser.sys and
# offers a COM port instead of a network adapter). Writing to the FAT partition
# is the only way to get diagnostics off the device.
#
# DO NOT MOUNT THE CARD HERE. /etc/mdev/mdev.sh already mounts /dev/mmcblk0p1 at
# /mnt/microsd on insertion, with -o sync,nodirty. An earlier version of this
# script mounted the same block device again at its own mountpoint with
# different options; the kernel refuses that with EBUSY, and because the error
# was discarded the script simply did nothing, on every boot, silently.
#
# The marker is matched as a GLOB. Windows hides known file extensions, so
# "create a file called smartcard-selftest" tends to produce
# smartcard-selftest.txt, which an exact match ignores.
#
# Runs at S90, after pcscd (S01), the app (S02) and mdev (S10), so the card is
# mounted by the time we look and boot is never delayed.

RESULT=smartcard-selftest-result.txt
MNT=/mnt/microsd
LOG=/tmp/selftest.log

start() {
    # Everything reports into $LOG, which is copied to the card next to the
    # report. Silent failure is what made the first two attempts undebuggable.
    : > "$LOG"
    say() { echo "$*" >> "$LOG"; }
    say "S90selftest starting"

    if [ ! -d "$MNT" ]; then
        # mdev mounts the card here on insertion; no mountpoint means no card.
        say "$MNT does not exist - card not inserted or not mounted by mdev"
        return 0
    fi

    marker=""
    for f in "$MNT"/smartcard-selftest* "$MNT"/SMARTCARD-SELFTEST*; do
        case "$f" in
            *"$RESULT") continue ;;   # never trigger on our own output
            *'*') continue ;;         # unmatched glob stays literal
        esac
        [ -f "$f" ] && { marker="$f"; break; }
    done
    [ -n "$marker" ] || return 0

    echo "Running smartcard self-test (requested by $(basename "$marker"))"
    say "marker: $marker"

    # Let pcscd come up and probe the serial reader before asking it anything.
    sleep 5

    if smartcard-selftest >> "$LOG" 2>&1; then
        say "-- self-test completed --"
    else
        say "-- self-test exited non-zero - partial report above --"
    fi

    cp "$LOG" "$MNT/$RESULT" 2>>"$LOG"
    sync

    # Consume the marker only once a result is actually on the card. Removing it
    # first left a failed run with neither a result nor a trigger.
    if [ -s "$MNT/$RESULT" ]; then
        rm -f "$marker"
        sync
        echo "self-test written to $RESULT"
    else
        echo "self-test produced no output; marker kept for a retry"
    fi
}

case "$1" in
    start)   start ;;
    stop)    : ;;
    restart) start ;;
    *)       echo "Usage: $0 {start|stop|restart}"; exit 5 ;;
esac
exit 0
